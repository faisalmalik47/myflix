# MyFlix Environment Variables Template
# Copy this file to .env.local and fill in your actual credentials

# Supabase Auth & Database (Self-Hosted or Cloud)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# The Movie Database (TMDB) API
VITE_TMDB_API_KEY=your-tmdb-api-key-or-access-token
VITE_TMDB_ACCESS_TOKEN=your-tmdb-bearer-token
